# AI 分析配置（可选，不配置则使用规则摘要）
# 仅保存在本机 .env 或运行环境中；不放入前端 JS、Git、截图、Issue 或 Actions 普通变量。
# 远程 BASE_URL 必须使用 HTTPS；HTTP 仅允许 localhost/回环 IP。
# BASE_URL 不接受用户名、密码、查询串或片段；凭据放 API_KEY。
# 方式一：单 endpoint（旧配置，向后兼容）
API_BASE_URL=https://api.example.com/v1
API_KEY=your-api-key-here
API_MODEL=model-name

# 方式二：多 endpoint（同供应商多 key 分摊配额 + 不同供应商故障转移）
# 编号配置优先于旧配置；同供应商写多编号即分摊，不同供应商即故障转移。
# 编号配置存在任意一个完整项后，不再回退旧配置（避免新旧混用导致 model/base_url 错配）。
#
# AI_FAILOVER_ON_TIMEOUT=1 时超时/连接错误也切换（默认），=0 仅 429/401/403 切换
# AI_FAILOVER_COOLDOWN_429=60   429 配额冷却秒数（默认 60）
# AI_FAILOVER_COOLDOWN_TIMEOUT=30  超时/连接错误冷却秒数（默认 30）
# AI_FAILOVER_COOLDOWN_AUTH=300  401/403 鉴权失败冷却秒数（默认 300）
# AI_PRIMARY_ONLY=1  主从模式：始终优先 API_1（主 endpoint），仅当主失败/冷却才
#                    切到后续备份，成功后不轮换（贴合"首选 X"诉求）；默认 0 = round-robin 均匀分摊
# AI_FAILOVER_ON_EMPTY=1  业务级失败（空内容/JSON解析失败）也切换 endpoint（默认开启）。
#                         =0 仅在业务层重试不触发故障转移（向后兼容旧行为）。
#                         注：JSON解析失败需调用方传 validate 回调才能拦截；空内容始终受此开关控制。
# AI_FAILOVER_COOLDOWN_EMPTY=0  业务级失败冷却秒数（默认 0=不冷却）。多 endpoint 主从模式
#                               建议设 30-60，避免主 endpoint 系统性业务级失败时每次重试都先撞
#                               注定失败的主 endpoint。单 endpoint 用户保持 0。
#
# API_1_BASE_URL=https://provider-a.com/v1
# API_1_KEY=sk-key-a1
# API_1_MODEL=model-a
# API_2_BASE_URL=https://provider-a.com/v1
# API_2_KEY=sk-key-a2
# API_2_MODEL=model-a
# API_3_BASE_URL=https://provider-b.com/v1
# API_3_KEY=sk-key-b
# API_3_MODEL=model-b

# 起点抓取（可选；进程环境变量优先于 .env）
# 字数缓存有效期，小时；到期进入刷新队列，0 表示每次都刷新。
# QD_DETAIL_TTL_HOURS=24
# 每次运行允许的详情页导航次数，重试也计数；0 表示不设上限。
# 达到上限后保存已完成结果，未刷新字数保留原采集时间。
# QD_DETAIL_MAX_REQUESTS=0
# 验证码或 HTTP 403/429/503 后的冷却秒数，最低 60；遵守更长的 Retry-After。
# QD_COOLDOWN_SECONDS=3600
# 临时打开浏览器窗口排查（默认无头）。
# QD_HEADED=0
