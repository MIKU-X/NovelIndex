#!/bin/sh
# Scan all reachable local history before transmission, including deleted files.
if [ -n "$NOVELINDEX_PYTHON" ]; then
    exec "$NOVELINDEX_PYTHON" scripts/check_publication.py --staged --history
elif [ -x .venv/Scripts/python.exe ]; then
    exec .venv/Scripts/python.exe scripts/check_publication.py --staged --history
elif [ -x .venv/bin/python ]; then
    exec .venv/bin/python scripts/check_publication.py --staged --history
elif command -v python3 >/dev/null 2>&1; then
    exec python3 scripts/check_publication.py --staged --history
else
    exec python scripts/check_publication.py --staged --history
fi
